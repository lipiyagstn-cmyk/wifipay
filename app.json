{
  "expo": {
    "name": "WiFiPay",
    "slug": "WiFiPay",
    "version": "1.0.0",
    "platforms": [
      "android",
      "ios"
    ],
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wifipayapp",
    "userInterfaceStyle": "automatic",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "WiFiPay memerlukan akses ke foto untuk melampirkan bukti keluhan.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "WiFiPay memerlukan kamera untuk memindai QR data pelanggan.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "WiFiPay memerlukan izin untuk menyimpan QR pelanggan ke galeri.",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "expo-sharing",
      "expo-asset",
      "expo-splash-screen",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    }
  }
}
